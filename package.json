{
  "name": "commandcode-mcp",
  "version": "2.0.3",
  "description": "MCP server that brings Command Code's codebase intelligence into Claude Desktop, VS Code, Cursor, and any MCP-compatible AI tool. 6 tools for querying code, continuing conversations, resuming sessions, learning coding style, and managing taste profiles — all from chat.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "commandcode-mcp": "build/index.js"
  },
  "files": [
    "build/",
    "!build/__tests__/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "test": "vitest --run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "command-code",
    "cmc",
    "ai",
    "coding-agent",
    "claude",
    "codebase",
    "code-analysis",
    "developer-tools"
  ],
  "author": "Imran",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IMRAN104/commandcode-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/IMRAN104/commandcode-mcp/issues"
  },
  "homepage": "https://github.com/IMRAN104/commandcode-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "fast-check": "^3.23.2",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
